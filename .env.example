# Copy this file to .env. Keep your real .env out of Git and ZIP shares.

PORT=5001

# Local Ollama: no Ollama website API key is required.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
# Per-request cap used by resume analysis and question generation (milliseconds).
OLLAMA_TIMEOUT_MS=120000
# Total question-generation deadline (milliseconds); this caps retries and streaming.
QUESTION_GENERATION_TIMEOUT_MS=90000
# Question-only JSON output keeps the model response compact.
QUESTION_GENERATION_NUM_PREDICT=300
QUESTION_GENERATION_NUM_CTX=4096
# Set to 1 to log safe request/validation categories while debugging.
DEBUG_QUESTION_GENERATION=0

# JWT authentication. Replace the sample value before exposing the server.
JWT_SECRET=replace-this-with-a-private-random-secret
JWT_EXPIRES_IN=4h

# Demo account seed. Development/demo only; change before using in a shared environment.
DEMO_USER_EMAIL=siddhant@capstone.demo
DEMO_USER_PASSWORD=demo1234
DEMO_USER_NAME=Siddhant Raikar
DEMO_USER_ID=000000000000000000000001

# MongoDB is required for `npm start` (web app); CLI resume evaluation does not use MongoDB.
MONGODB_URI=
MONGODB_DB_NAME=mock_interview_platform

# Integration tests must use a separate test database.
MONGODB_TEST_DB_NAME=mock_interview_platform_test
